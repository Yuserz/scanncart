# SCANnCART Dataset Pipeline - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# Roboflow API Key
# Get from: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_api_key_here

# Roboflow Project ID
# Found in your project URL: https://app.roboflow.com/workspace/PROJECT_ID/dataset
ROBOFLOW_PROJECT_ID=your_project_id_here
