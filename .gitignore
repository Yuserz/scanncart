.superpowers/

# Generated code graph (graph.json/html, GRAPH_REPORT.md). Local artifact —
# regenerate with `graphify update .`.
graphify-out/
.claude/settings.json
.claude/skills/run-desktop/shots/

# Ultralytics auto-downloads weights into the CWD; the real copy lives in
# sidecar/. A stray root copy is a 5.6 MB duplicate.
/yolo11n.pt
/yolo*.pt

# Sidecar runtime logs from a manually launched `python run.py`.
sidecar/*.log

# Runtime state, not source. `main.py`'s db_path is relative, so a sidecar launched with
# the repo root as its CWD writes a detection log here instead of into sidecar/data/.
# Whatever it logs, it is a session record rather than something to clone.
/data/

# The agent tooling's own project id.
.freebuff/
